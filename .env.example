# Base de datos Postgres (Neon, Supabase, Railway...). Necesaria para
# cuentas de usuario, suscripciones y resultados de tests.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — genera un valor aleatorio largo, por ejemplo con:
# openssl rand -base64 32
AUTH_SECRET=""

# Stripe — https://dashboard.stripe.com/register
# Clave secreta (Developers → API keys)
STRIPE_SECRET_KEY=""
# ID del precio recurrente mensual (Product catalog → tu producto → Pricing)
STRIPE_PRICE_ID=""
# ID del precio de pago único del pase de simulacros ilimitados (crea un
# producto de precio "único", no recurrente, en el catálogo de Stripe)
STRIPE_PRICE_ID_PASE_SIMULACROS=""
# Signing secret del webhook (Developers → Webhooks → tu endpoint)
STRIPE_WEBHOOK_SECRET=""

# Resend — https://resend.com (envío del email de activación de cuenta)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Oposit&go <cuenta@oposit-go.es>"
